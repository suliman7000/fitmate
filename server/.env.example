PORT=5000
# Local use: only this computer can reach the API. Remove this line when deploying.
HOST=127.0.0.1
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@cluster.example.mongodb.net/fitmate
# Password you will type on the login screen (use a long one)
APP_PASSWORD=
# At least 32 random characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
CLIENT_ORIGIN=http://localhost:5173
# Set to 1 when deployed behind a proxy (Render, Railway, Heroku...) so rate limiting sees real IPs
# TRUST_PROXY=1
